binds {
    // === System & Overview ===
    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // === Application Launchers ===
    Mod+Return hotkey-overlay-title="Terminal: Kitty" {spawn "kitty";}
    Mod+D hotkey-overlay-title="Launcher: Rofi" {spawn-sh "rofi -show drun";}
	Mod+B hotkey-overlay-title="Browser: Firefox" {spawn "firefox";}

    // Noctalia's own launcher (was: dms spotlight toggle)
    Mod+Space hotkey-overlay-title="Application Launcher" {
        spawn-sh "noctalia msg panel-toggle launcher";
    }
    // NOTE: Noctalia has no separate "spotlight-bar" surface like DMS did.
    // Pointed this at the same launcher toggle for now - remove/rebind if you'd rather free up Alt+Space.
    Alt+Space hotkey-overlay-title="Launcher (alt)" {
        spawn-sh "noctalia msg panel-toggle launcher";
    }
    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn-sh "noctalia msg panel-toggle clipboard";
    }
    // NOTE: Noctalia doesn't ship a task-manager/process-list panel like DMS's "processlist".
    // Left as a placeholder spawning a TUI process manager instead - swap for whatever you use, or drop the bind.
    Mod+M hotkey-overlay-title="Task Manager" {
        spawn-sh "kitty -e btop";
    }

    Super+X hotkey-overlay-title="Power Menu: Toggle" {
        spawn-sh "noctalia msg panel-toggle session";
    }
    Mod+Comma hotkey-overlay-title="Settings" {
        spawn-sh "noctalia msg settings-toggle";
    }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn-sh "noctalia msg panel-toggle wallpaper";
    }
    // NOTE: Noctalia doesn't have a standalone "notification center" panel toggle the way DMS did;
    // notification history lives inside Control Center. Mapped this to open Control Center instead.
    Mod+N hotkey-overlay-title="Notifications (Control Center)" {
        spawn-sh "noctalia msg panel-toggle control-center";
    }
    // NOTE: Noctalia has no notepad widget. No equivalent IPC call exists - left unbound/commented.
    // Mod+Shift+N hotkey-overlay-title="Notepad" { spawn-sh "noctalia msg panel-toggle notepad"; }

    // === Security ===
    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn-sh "noctalia msg screen-lock";
    }
    Mod+Shift+E { quit; }
    // Same caveat as Mod+M above - no built-in Noctalia task manager.
    Ctrl+Alt+Delete hotkey-overlay-title="Task Manager" {
        spawn-sh "kitty -e btop";
    }

    // === Audio Controls ===
    XF86AudioRaiseVolume allow-when-locked=true repeat=true {
        spawn-sh "noctalia msg volume-up";
    }
    XF86AudioLowerVolume allow-when-locked=true repeat=true {
        spawn-sh "noctalia msg volume-down";
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "noctalia msg volume-mute";
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "noctalia msg mic-mute";
    }
    XF86AudioPause allow-when-locked=true {
        spawn-sh "noctalia msg media toggle";
    }
    XF86AudioPlay allow-when-locked=true {
        spawn-sh "noctalia msg media toggle";
    }
    XF86AudioPrev allow-when-locked=true {
        spawn-sh "noctalia msg media previous";
    }
    XF86AudioNext allow-when-locked=true {
        spawn-sh "noctalia msg media next";
    }
    // NOTE: DMS let you bump the active MPRIS player's own volume separately from system volume
    // via "mpris increment/decrement". Noctalia's IPC doesn't expose per-player volume control,
    // so these now just nudge system volume like the plain volume keys above.
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-up";
    }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "noctalia msg volume-down";
    }

    Mod+F11 allow-when-locked=true {
        spawn-sh "noctalia msg media toggle";
    }
    Mod+F10 allow-when-locked=true {
        spawn-sh "noctalia msg media previous";
    }
    Mod+F12 allow-when-locked=true {
        spawn-sh "noctalia msg media next";
    }

    Mod+TouchpadScrollUp allow-when-locked=true {
        spawn-sh "noctalia msg volume-up";
    }
    Mod+TouchpadScrollDown allow-when-locked=true {
        spawn-sh "noctalia msg volume-down";
    }
    Mod+TouchpadScrollLeft allow-when-locked=true {
        spawn-sh "noctalia msg media previous";
    }
    Mod+TouchpadScrollRight allow-when-locked=true {
        spawn-sh "noctalia msg media next";
    }

    // === Brightness Controls ===
    XF86MonBrightnessUp allow-when-locked=true repeat=true {
       spawn-sh "~/.config/niri/scripts/brightness-step.sh up";
    }
    XF86MonBrightnessDown allow-when-locked=true repeat=true {
       spawn-sh "~/.config/niri/scripts/brightness-step.sh down";
    }

    // === Window Management ===
    Mod+Q repeat=false { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    // NOTE: DMS's "window-rules" creator UI has no Noctalia equivalent. Left unbound.
    // Mod+Shift+W hotkey-overlay-title="Create window rule" { spawn-sh "noctalia msg window-rules toggle"; }

    // === Focus Navigation ===
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }

    // === Window Movement ===
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }

    // === Column Navigation ===
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // === Monitor Navigation ===
    Mod+Ctrl+Left  { focus-monitor-left; }
    //Mod+Ctrl+Down  { focus-monitor-down; }
    //Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }

    // === Move to Monitor ===
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // === Workspace Navigation ===
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+Up   { move-column-to-workspace-up; }

    // === Workspace Management ===
    // NOTE: DMS's "workspace-rename" overlay has no Noctalia equivalent - Noctalia doesn't
    // provide workspace-naming UI. Left unbound.
    // Ctrl+Shift+R hotkey-overlay-title="Rename Workspace" { spawn-sh "noctalia msg workspace-rename"; }

    // === Move Workspaces ===
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // === Mouse Wheel Navigation ===
    Mod+Shift+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+WheelScrollDown      { focus-column-right; }
    Mod+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // === Numbered Workspaces ===
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // === Move to Numbered Workspaces ===
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // === Column Management ===
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Period { expel-window-from-column; }
    Mod+Tab { focus-workspace-previous; }

    // === Sizing & Layout ===
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // === Manual Sizing ===
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // === Screenshots ===
    XF86Launch1 { screenshot; }
    Ctrl+XF86Launch1 { screenshot-screen; }
    Alt+XF86Launch1 { screenshot-window; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // === Display Profiles ===
    // NOTE: DMS's "outputs cycleProfile" (its own display-profile manager) has no Noctalia
    // equivalent - Noctalia doesn't manage output profiles the same way. Left unbound.
    // Mod+P hotkey-overlay-title="Cycle Display Profile" { spawn-sh "noctalia msg outputs cycleProfile"; }

    // === System Controls ===
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+P { power-off-monitors; }
}
